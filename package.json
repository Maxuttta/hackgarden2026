{
  "name": "cyber-garden",
  "version": "1.3.1",
  "private": true,
  "description": "Cyber Garden · визуальный конструктор проверок Kotlin",
  "main": "garden/main.cjs",
  "scripts": {
    "start": "electron .",
    "setup:ai": "node scripts/setup-local-qwen.cjs",
    "dist": "electron-builder --win nsis --x64",
    "smoke": "node scripts/garden-smoke.cjs",
    "test": "node --test garden/reveal-file.test.cjs garden/source-drafts.test.cjs garden/workspace-store.test.cjs garden/source-edit.test.cjs garden/custom.test.cjs garden/test.cjs garden/github.test.cjs garden/reports.test.cjs",
    "smoke:reports": "node scripts/report-smoke.cjs",
    "smoke:mobile": "node scripts/mobile-smoke.cjs",
    "check": "node garden/cli.cjs"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.0.0",
    "playwright": "^1.64.1"
  },
  "build": {
    "appId": "org.cybergarden.workflow",
    "productName": "Cyber Garden",
    "asar": true,
    "asarUnpack": ["garden/select-in-explorer.vbs"],
    "files": [
      "garden/**/*",
      "package.json",
      "assets/fonts/**/*"
    ],
    "directories": {
      "output": "dist/garden"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true
    }
  }
}
